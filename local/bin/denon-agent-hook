#!/bin/bash
# Claude Code hook: keeps one state record per session for the My Agents bar
# widget, and sends a notification when a session needs you.
#   working  a prompt or tool is running
#   waiting  blocked on a permission prompt or a question (AskUserQuestion,
#            the only way to ask left in bypass-permissions mode)
#   done     the turn finished, your move
# Wired up in ~/.claude/settings.json (see plugins/denon.agents/README.md).
# Reads the hook's JSON on stdin and never prints: a UserPromptSubmit or
# SessionStart hook's stdout would land in the conversation.

exec >/dev/null 2>&1

dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/sessions"
mkdir -p "$dir"

input=$(cat)
event=$(jq -r '.hook_event_name // empty' <<<"$input")
id=$(jq -r '.session_id // empty' <<<"$input")
[[ -n $id ]] || exit 0
file="$dir/$id.json"
old=$(cat "$file" 2>/dev/null)

# A tool finishing in a session already marked working changes nothing. This
# runs after every tool call, so it leaves before doing anything costly.
[[ $event == PostToolUse && $(jq -r .state <<<"$old") == working ]] && exit 0

# Write the per-session records into one file the panel watches.
publish() {
  local tmp
  tmp=$(mktemp "$dir/../.sessions.XXXXXX")
  jq -s 'sort_by(.started)' "$dir"/*.json >"$tmp" 2>/dev/null || echo '[]' >"$tmp"
  mv "$tmp" "$dir/../sessions.json"
}

case $event in
  SessionEnd)
    rm -f "$file"
    publish
    exit 0
    ;;
  SessionStart) state=done ;;
  UserPromptSubmit | PostToolUse) state=working ;;
  Notification | PreToolUse) state=waiting ;;
  Stop) state=done ;;
  *) exit 0 ;;
esac

now=$(date +%s)
cwd=$(jq -r '.cwd // empty' <<<"$input")

if [[ -n $old ]]; then
  pid=$(jq -r .pid <<<"$old")
  window=$(jq -r '.window // empty' <<<"$old")
  started=$(jq -r .started <<<"$old")
else
  # The claude process this hook runs under: a record whose pid is gone
  # belongs to a session that crashed or was killed without a SessionEnd.
  ancestors=()
  p=$PPID
  while ((p > 1)); do
    ancestors+=("$p")
    [[ -z $pid && $(ps -o comm= -p "$p") == claude ]] && pid=$p
    p=$(ps -o ppid= -p "$p" | tr -d ' ')
  done
  # The terminal window the session lives in: the Hyprland client whose pid is
  # one of our ancestors. Terminals that serve every window from one process
  # (foot --server, single-instance Ghostty) fall back to the focused window,
  # which is the one you just started claude in.
  window=$(hyprctl clients -j | jq -r --argjson pids "[$(IFS=,; echo "${ancestors[*]}")]" \
    'map(select(.pid as $p | $pids | index($p))) | if length == 1 then .[0].address else empty end')
  [[ -n $window ]] || window=$(hyprctl activewindow -j | jq -r '.address // empty')
  started=$now
fi

# Name the session by its repository, and by the branch it is on. A worktree
# (claude --worktree) is still named after the repository it was cut from.
if common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  project=$(basename "$(dirname "$common")")
  branch=$(git -C "$cwd" branch --show-current)
else
  project=$(basename "$cwd")
  branch=""
fi

replace=$(jq -r '.notify // 0' <<<"$old")
since=$now
[[ $(jq -r .state <<<"$old") == "$state" ]] && since=$(jq -r .since <<<"$old")

jq -n --arg id "$id" --arg state "$state" --arg cwd "$cwd" --arg project "$project" \
  --arg branch "$branch" --arg window "$window" --argjson pid "${pid:-0}" \
  --argjson started "$started" --argjson since "$since" --argjson notify "${replace:-0}" \
  '{id: $id, agent: "claude", state: $state, since: $since, started: $started,
    cwd: $cwd, project: $project, branch: $branch, window: $window, pid: $pid, notify: $notify}' >"$file.tmp"
mv "$file.tmp" "$file"

# Sweep records of sessions that died without saying goodbye.
# ponytail: only runs on the next hook event from any session, so a killed
# session's row lingers until then; add a timer in the panel if that matters.
for f in "$dir"/*.json; do
  p=$(jq -r '.pid // 0' "$f")
  ((p > 0)) && ! kill -0 "$p" 2>/dev/null && rm -f "$f"
done
publish

# Ping only when the session hands the turn back, and not while you are
# already looking at its window. Clicking the notification jumps to it.
[[ $state == working || $event == SessionStart ]] && exit 0
[[ -n $window && $(hyprctl activewindow -j | jq -r '.address // empty') == "$window" ]] && exit 0

label=$project
[[ -n $branch ]] && label+=" · $branch"
if [[ $state == waiting ]]; then
  headline="Claude needs you"
  body="$label — $(jq -r '.message // .tool_input.questions[0].question // "waiting for input"' <<<"$input")"
else
  headline="Claude is done"
  body=$label
fi

focus=()
[[ -n $window ]] && focus=(--exec hyprctl dispatch focuswindow "address:$window")
# One notification per session: each new one replaces the last instead of
# stacking up a turn-by-turn history.
notify=$(omarchy-notification-send --app-name "Claude Code" -g "󰚩" -u normal -r "${replace:-0}" -p \
  "$headline" "$body" "${focus[@]}" </dev/null 2>/dev/null)
[[ $notify =~ ^[0-9]+$ ]] && jq --argjson n "$notify" '.notify = $n' "$file" >"$file.tmp" && mv "$file.tmp" "$file"
